// path: backend/.env.example

# Server
NODE_ENV=development
PORT=4000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=research_ustad_workshop

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-string-in-production
JWT_EXPIRES_IN=8h

# Admin seed (used only by seed-admin.ts — do NOT commit real values)
ADMIN_EMAIL=admin@researchustad.org
ADMIN_PASSWORD=ChangeMeStrongPassword123!
ADMIN_FULL_NAME=Research Ustad Admin

# SMTP (for email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password